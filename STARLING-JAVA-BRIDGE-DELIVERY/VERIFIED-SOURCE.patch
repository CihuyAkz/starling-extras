+fn is_fabric_jar(path: &Path) -> bool {
+    let Ok(file) = File::open(path) else {
+        return false;
+    };
+    let Ok(file_meta) = file.metadata() else {
+        return false;
+    };
+    if file_meta.len() > 256 << 20 {
+        return false;
+    }
+    let Ok(mut archive) = zip::ZipArchive::new(file) else {
+        return false;
+    };
+    if archive.len() > 65_536 {
+        return false;
+    }
+    let Ok(mut manifest) = archive.by_name("fabric.mod.json") else {
+        return false;
+    };
+    if manifest.size() > 1 << 20 {
+        return false;
+    }
+    let mut bytes = Vec::new();
+    if std::io::Read::read_to_end(&mut manifest, &mut bytes).is_err() {
+        return false;
+    }
+    let Ok(metadata) = serde_json::from_slice::<serde_json::Value>(&bytes) else {
+        return false;
+    };
+    metadata
+        .get("id")
+        .and_then(serde_json::Value::as_str)
+        .is_some_and(|id| {
+            id.len() <= 64
+                && id
+                    .as_bytes()
+                    .first()
+                    .is_some_and(|byte| byte.is_ascii_lowercase())
+                && id.bytes().all(|byte| {
+                    byte.is_ascii_lowercase()
+                        || byte.is_ascii_digit()
+                        || byte == b'_'
+                        || byte == b'-'
+                })
+        })
+        && metadata
+            .get("version")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|version| !version.is_empty() && version.len() <= 128)
 }
 
