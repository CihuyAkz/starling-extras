-    /// The curse on the player in place; whether it took.
-    fn elder_curse_player(&mut self, at: [f64; 3]) -> bool {
-        if self.creative || self.spectator() {
-            return false;
-        }
-        let Some(p) = self.player.as_ref() else {
-            return false;
-        };
