-/// A hit, a use, a block placed or broken, an item dropped: what Free Direction steering
-/// rests after (`Game::send`).
-fn is_interaction(packet: &S) -> bool {
-    matches!(
-        packet,
-        S::PlayerAction(_) | S::Attack(_) | S::Interact(_) | S::UseItemOn(_) | S::UseItem(_)
-    )
-}
