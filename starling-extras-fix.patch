-/// A row for each native mod the launcher installed in `dir` (`<id>.hnmod`) that this game wasn't
-/// built with (`built`: its [`BUILD_INFO`], empty for a release or Nightly) and that has no row
-/// yet. The page said "No mods" before, and players copied the files into `horizon-mods` (#4770).
-/// Its toggle is the `mod.<id>` line the launcher's next build follows.
-fn not_built(dir: &std::path::Path, built: &str, rows: &[Installed]) -> Vec<Installed> {
-    let info: serde_json::Value = serde_json::from_str(built).unwrap_or_default();
-    let in_build = |id: &str| {
-        info["mods"]
-            .as_array()
-            .is_some_and(|mods| mods.iter().any(|m| m["id"] == id))
-    };
-    let mut paths: Vec<PathBuf> = std::fs::read_dir(dir)
-        .map(|d| d.flatten().map(|e| e.path()).collect())
-        .unwrap_or_default();
-    paths.retain(|p| p.extension().is_some_and(|e| e == "hnmod"));
-    paths.sort();
-    let mut out: Vec<Installed> = Vec::new();
-    for path in paths {
-        let bundle = match horizon_mods::index::native::Bundle::read(&path) {
-            Ok(bundle) => bundle,
-            // Said on its row: a file left out without a word looks like the folder isn't read.
-            Err(e) => {
-                let title = path
-                    .file_name()
-                    .unwrap_or_default()
-                    .to_string_lossy()
-                    .into_owned();
-                let shown = |row: &Installed| row.id.is_empty() && row.title == title;
-                if !rows.iter().chain(&out).any(shown) {
-                    out.push(Installed {
-                        title,
-                        id: String::new(),
-                        description: String::new(),
-                        problem: Some(format!("Not a native mod Starling can read: {e}")),
-                        dev: false,
-                        native: None,
-                    });
-                }
-                continue;
-            }
-        };
-        let m = bundle.manifest;
-        if horizon_client::mod_list::is_retired_map_mod(&m.id) {
-            continue;
-        }
-        let listed = rows.iter().chain(&out).any(|row| row.id == m.id);
-        if !listed && !in_build(&m.id) && !mod_list::is_android_bundled(&m.id) {
-            out.push(Installed {
-                title: format!("{} {}", display_name(&m.id), m.version),
-                id: m.id,
-                description: String::new(),
-                problem: Some(mod_list::NOT_BUILT.to_owned()),
-                dev: false,
-                native: None,
-            });
-        }
-    }
-    out
-}
