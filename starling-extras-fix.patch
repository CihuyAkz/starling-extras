-const TANK: &str = "horizon_fluid";
-/// A bucket's capacity, vanilla's `FluidType.BUCKET_VOLUME`.
-const BUCKET: i32 = 1000;
-const MOD_CAPACITY: std::ops::RangeInclusive<i32> = 1..=1_000_000;
