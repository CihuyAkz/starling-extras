-/// `Entity.getRootVehicle`: up the vehicles `vehicle_of` gives, from `id`.
-fn root_vehicle(id: u32, vehicle_of: impl Fn(u32) -> Option<u32>) -> u32 {
-    let mut root = id;
-    // A bound against a loop of mounts.
-    for _ in 0..16 {
-        match vehicle_of(root) {
-            Some(v) if v != root => root = v,
-            _ => break,
-        }
-    }
