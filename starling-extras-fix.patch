-                    l.ops
-                        .entries()
-                        .iter()
-                        .map(|e| e.user.name.clone())
-                        .collect(),
-                    l.bans
-                        .entries()
-                        .iter()
-                        .map(|e| e.user.name.clone())
-                        .collect(),
-                    l.ip_bans.entries().iter().map(|e| e.user.clone()).collect(),
-                    l.white
-                        .entries()
-                        .iter()
-                        .map(|e| e.user.name.clone())
-                        .collect(),
-                )
-            }
-            None => Default::default(),
