-        }
-        match self.game.pick() {
-            Some(h) => Hit::Block {
-                pos: h.pos,
-                face: match h.face {
-                    [0, -1, 0] => 0,
-                    [0, 1, 0] => 1,
-                    [0, 0, -1] => 2,
-                    [0, 0, 1] => 3,
-                    [-1, 0, 0] => 4,
-                    _ => 5,
-                },
