-    pub(super) fn cmd_spreadplayers(&mut self, ctx: &Context) -> R<i32> {
-        let centre = self
-            .position_arg(ctx, "center")
-            .unwrap_or_else(|| self.source_position());
-        let float = |name: &str| match ctx.get(name) {
-            Some(Arg::Float(v)) => f64::from(*v),
