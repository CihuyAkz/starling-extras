-            self.level_entity(id).map(|t| {
-                (
-                    self.target_type(t),
-                    self.target_position(t).unwrap_or_default(),
-                )
-            })
-        };
-        if let Some((kind, at)) = aimed
-            && self.as_guest(host, conn, |g| {
-                let mut canceled = false;
-                g.native_attack_entity(id, &kind, at, &mut canceled);
-                canceled
