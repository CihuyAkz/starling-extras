-        let facing_angle = match f {
-            [1, 0, 0] => 90.0f32,
-            [0, 0, -1] => 180.0,
-            [-1, 0, 0] => 270.0,
-            _ => 0.0,
-        };
-        let y =
-            facing_angle + if upward { 180.0 } else { 0.0 } + if sideways { 270.0 } else { 0.0 };
