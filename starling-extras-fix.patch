-        let centre_f = [centre[0] as f32, centre[2] as f32];
-        let (cx, cz) = (f64::from(centre_f[0]), f64::from(centre_f[1]));
-        let (min_x, max_x) = (cx - range, cx + range);
-        let (min_z, max_z) = (cz - range, cz + range);
