-#[derive(Clone, Copy)]
-enum Format {
-    Default,
-    Tenths,
-    Distance,
-    Time,
-}
-fn two(v: f64) -> String {
-    format!("{v:.2}")
-}
-/// `StatFormatter`.
-fn format(f: Format, v: i32) -> String {
-    match f {
-        Format::Default => {
-            // NumberFormat.getIntegerInstance(Locale.US): thousands separators.
-            let digits = v.unsigned_abs().to_string();
-            let mut out = String::new();
-            for (i, c) in digits.chars().enumerate() {
-                if i > 0 && (digits.len() - i).is_multiple_of(3) {
-                    out.push(',');
-                }
-                out.push(c);
-            }
-            if v < 0 {
-                out.insert(0, '-');
-            }
-            out
-        }
-        Format::Tenths => two(f64::from(v) * 0.1),
-        Format::Distance => {
-            let m = f64::from(v) / 100.0;
-            let km = m / 1000.0;
-            if km > 0.5 {
-                format!("{} km", two(km))
-            } else if m > 0.5 {
-                format!("{} m", two(m))
-            } else {
-                format!("{v} cm")
-            }
-        }
-        Format::Time => {
-            let s = f64::from(v) / 20.0;
-            let (min, h) = (s / 60.0, s / 3600.0);
-            let (d, y) = (h / 24.0, h / 24.0 / 365.0);
-            if y > 0.5 {
-                format!("{} y", two(y))
-            } else if d > 0.5 {
-                format!("{} d", two(d))
-            } else if h > 0.5 {
-                format!("{} h", two(h))
-            } else if min > 0.5 {
-                format!("{} min", two(min))
-            } else {
-                // Java's double + " s".
-                let mut t = String::new();
-                let _ = write!(t, "{s:?}");
-                format!("{t} s")
-            }
-        }
-    }
-}
