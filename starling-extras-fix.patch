-        // source): an operator's on a dedicated server, never the host's.
-        let Some(permission) = host.hub.guest(conn).map(|g| g.permission) else {
-            return;
-        };
-        host.commands.push(GuestCommand {
-            conn,
-            command: command.trim_start_matches('/').to_owned(),
