-fn circle(ui: &mut Ui, c: [f32; 2], r: f32, fill: u32) {
-    let d = ui.density;
-    ui.rounded(
-        (c[0] - r) / d,
-        (c[1] - r) / d,
-        2.0 * r / d,
-        2.0 * r / d,
-        r / d,
-        fill,
-    );
-}
-fn label(ui: &mut Ui, c: [f32; 2], r: f32, text: &str, tint: u32) {
-    let d = ui.density;
-    let size = (r / d * 0.5).clamp(9.0, 16.0);
