-    /// Commands.performCommand for a guest with command access.
-    /// Commands.performCommand for a guest, with the message arguments it
-    /// signed (none after an unsigned command packet).
-    pub(super) fn guest_command(
-        &mut self,
-        host: &mut LanHost,
