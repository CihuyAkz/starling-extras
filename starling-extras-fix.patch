-/// Commands that only read. Polling them must not flood the ring or make an
-/// agent that is merely watching look like it acted.
-const READ_ONLY: &[&str] = &[
-    "state",
-    "status",
-    "events",
-    "wait-for",
-    "input-log",
-    "record-status",
-    "record-list",
-    "looking-at",
-    "entities",
-    "block",
-    "blocks",
-    "light",
-    "inventory",
-    "screen",
-    "menu",
-    "messages",
-    "worlds",
-    "servers",
-    "options-get",
-    "stats",
-    "logs",
-    "ui",
-];
-
-/// Commands that steer the session rather than the game: recording them as
-/// input would put `record-stop` in a replay it must not run.
-const SESSION: &[&str] = &[
-    "record-start",
-    "record-stop",
-    "record-replay",
-    "repro-export",
-    "quit",
-    "launch",
-    "mcp",
-    "bench",
-    "sleep",
-];
