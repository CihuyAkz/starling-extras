-        let (dx, dz) = if face[1] != 0 {
-            match ((self.yaw / 90.0 + 0.5).floor() as i32).rem_euclid(4) {
-                0 => (0, -1),
-                1 => (1, 0),
-                2 => (0, 1),
-                _ => (-1, 0),
-            }
-        } else {
-            (face[0], face[2])
-        };
-        let facing = match (dx, dz) {
-            (0, -1) => "north",
-            (0, 1) => "south",
