-    fn cmd_locate_poi(&mut self, ctx: &Context) -> R<i32> {
-        let Some(Arg::Resource(poi)) = ctx.get("poi").cloned() else {
-            return Ok(0);
-        };
-        let wanted: Vec<String> = match poi.strip_prefix('#') {
-            Some(tag) => self.tag_entries("point_of_interest_type", tag),
-            None => vec![poi.clone()],
