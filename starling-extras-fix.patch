-        };
-        let blocks = list
-            .iter()
-            .filter_map(|b| {
-                let state = horizon_world::chunk::BlockState::from_nbt(b.get("State")?).ok()?;
-                Some((
-                    [int(b, "X"), int(b, "Y"), int(b, "Z")],
-                    registry.id(&state)?,
-                ))
-            })
-            .collect();
-        Some(FallingTree {
-            blocks,
-            cut: three("Cut")?,
-            toward: three("Toward")?,
-            since: match tag.get("Since") {
-                Some(Tag::Long(v)) => *v,
-                _ => 0,
-            },
-        })
-    }
-}
-
-impl Game<'_> {
-    /// The tree the saw at `saw` cut at `cut`, falling `toward` its facing: kept in the saw's
