-            }
-        }
-        for f in &self.item_frames {
-            let (lo, hi) = f.bounds();
-            let at = Vec3::new(
-                (lo[0] + hi[0]) / 2.0,
-                (lo[1] + hi[1]) / 2.0,
-                (lo[2] + hi[2]) / 2.0,
-            );
-            if keys.contains(&chunk_of(at)) {
-                let uuid = self
-                    .persist
-                    .uuids
-                    .get(&f.id)
-                    .copied()
-                    .unwrap_or_else(random_uuid);
-                let tag = entity_nbt::item_frame_to_nbt(f, uuid, self.persist.raw.get(&f.id));
