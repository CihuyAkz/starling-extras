-/// The 36 inventory slots and the off hand as one list ([`OFFHAND`] last).
-fn slots<'a>(
-    inventory: &'a mut [Option<ItemStack>],
-    offhand: &'a mut Option<ItemStack>,
-) -> Vec<&'a mut Option<ItemStack>> {
-    inventory
-        .iter_mut()
-        .take(36)
-        .chain(std::iter::once(offhand))
-        .collect()
-}
