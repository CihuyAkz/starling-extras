-/// Each generation has its own channel and progress. Pack changes wait for the
-/// old tail before starting another generation, including cache/global writes.
-pub(super) fn spawn_loader(
-    options: &Options,
-    settings: &Settings,
-    vanilla_root: &std::path::Path,
-    started: Instant,
-    progress: &Progress,
-) -> Result<(Receiver<LoaderMsg>, JoinHandle<()>)> {
-    #[cfg(target_os = "android")]
-    crate::diagnostics::checkpoint("resource_loading", || serde_json::json!({}));
-    let (sender, receiver) = std::sync::mpsc::channel();
-    let settings = settings.clone();
-    let vanilla_root = vanilla_root.to_path_buf();
-    let dev_mods = options.dev_mods.clone();
-    let world = launch_world(options).map(str::to_owned);
-    let progress = progress.clone();
-    let handle = std::thread::Builder::new()
-        .name("resource-loader".into())
-        .spawn(move || {
-            let mut pack_error = None;
-            let root = packs::startup_root(&vanilla_root, &settings.resource_packs, &[])
-                .unwrap_or_else(|error| {
-                    pack_error = Some(error.to_string());
-                    vanilla_root.clone()
-                });
-            // A content build takes a while (about 40 s on a phone for Create): the menu bundle
-            // goes first, so the loading screen can say what it waits for.
-            let registries = super::world_content::next_start().map(|next| &next.content);
-            let mut menu_sent = false;
-            let root = mods::content_root(
-                &root,
-                &settings.mods.enabled,
-                &dev_mods,
-                registries,
-                &mut |note| {
-                    progress.note(Some(note.text()));
-                    if !std::mem::replace(&mut menu_sent, true)
-                        && let Ok(ui) = UiResources::load(&root, &vanilla_root)
-                    {
-                        let _ = sender.send(LoaderMsg::Ui(ui, root.clone()));
-                    }
-                },
-            );
-            progress.note(None);
-            let result = load_resources(
-                root,
-                world.as_deref(),
-                &vanilla_root,
-                &settings,
-                started,
-                true,
-                false,
-                &progress,
-                &mut |gui, root| {
-                    let _ = sender.send(LoaderMsg::Ui(gui, root.to_path_buf()));
-                },
-            )
-            .map(|mut loaded| {
-                loaded.pack_error = loaded.pack_error.or(pack_error);
-                loaded
-            })
-            .map_err(|error| error.to_string());
-            let _ = sender.send(LoaderMsg::Done(result));
-        })?;
-    Ok((receiver, handle))
-}
