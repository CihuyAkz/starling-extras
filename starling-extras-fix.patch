-        }
-        if self.dialog_type(&text) {
-            return;
-        }
-        if self.title.is_some() {
-            self.title_edit(Some(&text), false);
-        } else if self.book.is_some() {
-            self.book_input(None, Some(&text));
-        } else if self.sign_edit.is_some() {
