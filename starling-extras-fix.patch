-        if let Some(window) = &self.window
-            && self.ime_allowed
-        {
-            window.set_ime_cursor_area(
-                winit::dpi::PhysicalPosition::new(x, y),
-                winit::dpi::PhysicalSize::new(width as u32, height as u32),
-            );
-            self.ime_area = Some(area);
-        }
