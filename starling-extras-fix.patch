-            return;
-        };
-        let scale = hud.scale;
-        let x = (x0 * scale).round() as i32;
-        let y = (y0 * scale).round() as i32;
-        let width = (((x1 - x0) * scale).round() as i32).max(1);
-        let height = (((y1 - y0) * scale).round() as i32).max(1);
-        let area = [x, y, width, height];
