-    particles: &mut ParticleEngine,
-    feet: Vec3,
-    size: (f64, f64),
-    list: &[ParticleOptions],
-    ambient: bool,
-    invisible: bool,
-) {
-    if list.is_empty() {
-        return;
-    }
-    let bound = if invisible { 15 } else { 4 } * if ambient { 5 } else { 1 };
-    let r = particles.random();
-    let Ok(0) = r.next_int_bound(bound) else {
-        return;
-    };
