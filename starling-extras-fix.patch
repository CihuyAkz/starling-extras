-            _ => {
-                let cleared = !title.has_caret_field()
-                    && title
-                        .focused_field()
-                        .is_some_and(|(id, value, _)| self.selection.take(id, value));
-                if cleared {
-                    title.search_changed();
-                }
-                if event.physical_key == PhysicalKey::Code(KeyCode::Backspace) {
