-                    avg[0] /= f64::from(neighbours);
-                    avg[1] /= f64::from(neighbours);
-                    let length = (avg[0] * avg[0] + avg[1] * avg[1]).sqrt();
-                    if length > 0.0 {
-                        points[i][0] -= avg[0] / length;
-                        points[i][1] -= avg[1] / length;
-                    } else {
-                        points[i][0] = next(self, min_x, max_x);
-                        points[i][1] = next(self, min_z, max_z);
-                    }
-                    collisions = true;
-                }
-                let p = &mut points[i];
-                let before = *p;
-                p[0] = if p[0] < min_x {
-                    min_x
-                } else if p[0] > max_x {
-                    max_x
-                } else {
-                    p[0]
-                };
-                p[1] = if p[1] < min_z {
-                    min_z
-                } else if p[1] > max_z {
-                    max_z
