-        }
-        // getAdvancements: parents first (nearest up), the target, then
-        // the subtree depth first.
-        let list: Vec<usize> = match index {
-            None => (0..tree.list.len()).collect(),
-            Some(i) => {
-                let mut out = Vec::new();
-                if ctx.has("until") || ctx.has("through") {
