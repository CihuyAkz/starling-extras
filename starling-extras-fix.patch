-            let out = &mut self.game_tests.outbox;
-            out.push(Out::Console {
-                text: Text::translate("commands.test.summary", &[number(total as i32)])
-                    .with_color(text::WHITE),
-                broadcast: true,
-            });
-            if failed_required > 0 {
-                out.push(Out::Console {
-                    text: Text::translate(
-                        "commands.test.summary.failed",
