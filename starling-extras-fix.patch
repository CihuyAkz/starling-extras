-    fn start_task(
-        &mut self,
-        name: &'static str,
-        kind: TaskKind,
-        reply: &Sender<String>,
-        timeout: f64,
-    ) -> Result<Handled> {
-        self.agent.task = Some(Task {
-            kind,
-            reply: reply.clone(),
-            deadline: Instant::now() + Duration::from_secs_f64(timeout.clamp(0.05, 3600.0)),
-            name,
-        });
-        Ok(Handled::Deferred)
-    }
