-        else {
-            return;
-        };
-        let model = |i: usize| {
-            part.models
-                .get(i)
-                .and_then(|m| catalog.partial(m, [0, 0, 0]))
-        };
-        let f = segment.facing;
-        let (upward, downward) = (
-            segment.slope == Slope::Upward,
-            segment.slope == Slope::Downward,
