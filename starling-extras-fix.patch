-/// `Entity.getPassengersAndSelf` of `root`, from each rider's mount.
-fn vehicle_tree(root: u32, mounts: &[(u32, Option<u32>)]) -> Vec<u32> {
-    let mut tree = vec![root];
-    let mut k = 0;
-    while k < tree.len() {
-        let v = tree[k];
-        let riders: Vec<u32> = mounts
-            .iter()
-            .filter(|(id, m)| *m == Some(v) && !tree.contains(id))
-            .map(|(id, _)| *id)
-            .collect();
-        tree.extend(riders);
-        k += 1;
-    }
-    tree
-}
