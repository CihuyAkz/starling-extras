-fn color_index(color: &str) -> i32 {
-    bossbar::COLORS
-        .iter()
-        .position(|c| *c == color)
-        .unwrap_or(6) as i32
-}
-fn style_index(style: &str) -> i32 {
-    bossbar::STYLES
-        .iter()
-        .position(|s| *s == style)
-        .unwrap_or(0) as i32
-}
