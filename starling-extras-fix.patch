-            return Ok(Text::empty());
-        };
-        // numberFormatOrDefault(StyledFormat.NO_STYLE).
-        let format = (score.number_format.clone())
-            .or_else(|| objective.number_format.clone())
-            .unwrap_or(horizon_client::scoreboard::NumberFormat::Styled(
-                serde_json::json!({}),
