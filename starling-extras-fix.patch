-pub(super) fn bow_release_power(has_ammo: bool, charge: i32, canceled: bool) -> Option<f32> {
-    if canceled || charge < 0 || !has_ammo {
-        return None;
-    }
-    let f = charge as f32 / 20.0;
-    let power = ((f * f + f * 2.0) / 3.0).min(1.0);
-    (power >= 0.1).then_some(power)
