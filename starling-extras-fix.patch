-/// A sub-rectangle of a sprite given in texels.
-fn sub_rect(r: Rect, [x, y, w, h]: [f32; 4]) -> Rect {
-    let (du, dv) = ((r.u1 - r.u0) / r.w as f32, (r.v1 - r.v0) / r.h as f32);
-    Rect {
-        u0: r.u0 + x * du,
-        v0: r.v0 + y * dv,
-        u1: r.u0 + (x + w) * du,
-        v1: r.v0 + (y + h) * dv,
-        w: w as u32,
-        h: h as u32,
-    }
-}
