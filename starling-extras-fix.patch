-            };
-            let changes = map.take_sync_changes();
-            if changes.is_empty() {
-                continue;
-            }
-            let message = Message {
-                holder,
-                replace: false,
-                changes,
-            };
-            for guest in recipients(hub, holder) {
-                guest.send_attachment_sync(&message);
-            }
-        }
-    }
-}
