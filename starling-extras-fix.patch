-    let mut taken = 0;
-    for i in order(selected) {
-        let slot = &mut *slots[i];
-        if let Some(s) = slot
-            && &*s.item == item
-            && plain(s)
-        {
-            let n = s.count.min(count - taken);
-            s.count -= n;
-            taken += n;
-            if s.count == 0 {
-                *slot = None;
-            }
-        }
-        if taken == count {
-            break;
-        }
-    }
-    taken
-}
