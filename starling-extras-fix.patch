-        let mut path = self.dragon_path(current, target, Some(last));
-        if let Some(path) = path.as_mut() {
-            path.advance();
-        }
-        let mut boxed = path.map(PathBox);
-        let target = self.next_target(&mut boxed);
-        if let Some(Dragon {
-            phase: Phase::Strafe {
-                path, target: t, ..
-            },
-            ..
-        }) = self.dragon.as_mut()
-        {
-            *path = boxed;
-            *t = target;
-        }
-    }
