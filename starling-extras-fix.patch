-/// 0xRRGGBB `tint` times `brightness`, as an opaque vertex colour.
-fn shaded(tint: u32, brightness: f32) -> u32 {
-    let c = |shift: u32| (((tint >> shift) & 255) as f32 * brightness) as u32;
-    0xFF00_0000 | c(0) << 16 | c(8) << 8 | c(16)
-}
