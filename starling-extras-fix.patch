-            position: b.position,
-            center: center(b),
-            width: f64::from(WIDTH),
-            height: f64::from(HEIGHT),
-            yaw: b.yaw,
-            velocity: b.velocity,
-        },
-    )
-}
-fn distance(a: Vec3, b: Vec3) -> f64 {
-    ((a.x - b.x).powi(2) + (a.y - b.y).powi(2) + (a.z - b.z).powi(2)).sqrt()
