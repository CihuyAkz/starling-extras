-    fn sb_mut(&mut self) -> &mut Scoreboard {
-        &mut self.g.score.board
-    }
-    fn select(&mut self, selector: &Selector) -> Vec<Holder> {
-        let found = self.g.select(selector);
-        found
-            .into_iter()
-            .filter_map(|t| self.g.holder_for(t))
-            .collect()
