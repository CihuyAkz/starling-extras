-    fn remote_team(&mut self, p: play::SetPlayerTeam) {
-        use horizon_client::scoreboard::{CollisionRule, Visibility, tag_to_json};
-        let board = &mut self.score.board;
-        if p.method == 1 {
-            board.remove_team(&p.name);
