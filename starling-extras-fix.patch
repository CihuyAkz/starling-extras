-            Ok(answer) => Some(answer),
-            Err(RecvTimeoutError::Timeout) => {
-                log::warn!(
-                    "Horizon: the server thread did not answer within {} s (running: {}, \
-                     autosaving: {}, smoothed tick {:.1} ms)",
-                    CALL_TIMEOUT.as_secs(),
-                    !self.stopped(),
-                    self.is_saving(),
-                    self.smoothed_tick_ms()
