-                && let Some(name) = self
-                    .native_server_players()
-                    .into_iter()
-                    .find(|p| p.uuid == player)
-                    .map(|p| p.name)
-            {
-                self.native_player_item_mend(player, &name, &item, repaired, amount);
-            }
-            if remaining == 0 {
-                return 0;
-            }
-            amount = remaining;
-        }
-    }
