-        let slice: String = chars[start..end].iter().collect();
-        // MultilineTextField.LINE_SEEK_PIXEL_BIAS: vanilla biases this seek, not the drawn caret.
-        let pos = start + self.gui.atlas.font.fit(&slice, x + 2.0);
