-        && let Ok(meta) = serde_json::from_str::<Value>(&text)
-    {
-        for path in [
-            "/world",
-            "/start/world",
-            "/start/server/name",
-            "/start/server/address",
-        ] {
-            if let Some(value) = meta.pointer(path).and_then(Value::as_str) {
-                terms.push(value.to_owned());
-            }
-        }
-    }
