-    /// arrow (`ClientPacketListener.handleTakeItemEntity`).
-    pub(super) fn touch_arrows(&mut self) {
-        use horizon_client::arrows::Touch;
-        let Some(p) = self.player.as_ref() else {
-            return;
-        };
-        if p.health.dead_or_dying() || self.spectator() {
-            return;
-        }
